@model BaseballGameTracker.Data.Email

@{
    ViewData["Title"] = "DeleteEntry";
}

<h1>Delete Email</h1>

<h4>Please Enter your email if you want it removed! </h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="DeleteBasedOnEmail">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="EmailAddress" class="control-label"></label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>

            <br />
           
            <div class="form-group">
                <input type="submit" value="Delete" class="btn btn-warning" />
            </div>
        </form>
    </div>
</div>
<br/>
<div>
    @* <a asp-action="Index">Back to List</a> *@
    <form action="/Home/Index" method="post">
        <button class="btn btn-secondary">Return to home</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
