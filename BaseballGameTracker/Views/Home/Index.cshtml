
@model RecordVM
@{
    ViewData["Title"] = "Home";
}

<div class="text-center grey">
    <h1 class="display-4">Welcome</h1>
    <h2>This is a simple app that keeps track of the Cardinal games!</h2>
    <p>Please follow the Add Email tab if you would like to get emails on the games.</p>
    <p>If you want to stop getting emails please follow the Delete Email tab.</p>

    <div class="wins-loses">

        <div class="wins">
            <h1>Wins</h1>
            <h1> @Model.Wins</h1>
        
        </div>

        <div class="spacer">

        </div>

        <div class="loses">
            <h1>Loses</h1>
            <h1> @Model.Loses</h1>

        </div>


    </div>

</div>
