@model GameReadOnlyVM

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Game</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CardinalsScore)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CardinalsScore)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OpposingTeamScore)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OpposingTeamScore)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OpponentName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OpponentName)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
